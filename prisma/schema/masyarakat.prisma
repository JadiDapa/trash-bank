model Masyarakat {
  id             Int              @id @default(autoincrement())
  userId         Int              @unique
  name           String
  nik            String           @unique
  address        String
  gender         Gender
  phone          String
  email          String
  ktpImageUrl    String
  status         MasyarakatStatus @default(WAITING)
  rejectedReason String?
  points         Float            @default(0)
  totalGrammage  Float            @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositTickets DepositTicket[]
  voucherTickets VoucherTicket[]
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum MasyarakatStatus {
  WAITING
  APPROVED
  REJECTED
}
