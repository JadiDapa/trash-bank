model VoucherTicket {
  id             Int                  @id @default(autoincrement())
  masyarakatId   Int
  adminId        Int
  status         VoucherTicketStatus  @default(PENDING)
  pointsUsed     Float
  voucherSerial  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  masyarakat     Masyarakat           @relation(fields: [masyarakatId], references: [id])
  admin          Admin                @relation(fields: [adminId], references: [id])
}

enum VoucherTicketStatus {
  PENDING
  COMPLETED
  CANCELLED
}
