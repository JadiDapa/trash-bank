model User {
  id         Int        @id @default(autoincrement())
  clerkId    String     @unique
  role       UserRole   @default(MASYARAKAT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  admin      Admin?
  masyarakat Masyarakat?
  education  Education[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MASYARAKAT
}
